<html>
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Oi&display=swap"
      rel="stylesheet"
    />
    <title>🎉 Your Event Access Is Ready!</title>
    <style>
      @font-face {
        font-family: "Spongebob";
        src: url("../font/Spongeboy-Me-Bob.woff2") format("woff2"),
          url("../font/Spongeboy-Me-Bob.woff") format("woff");
        font-weight: normal;
        font-style: normal;
      }

      body {
        font-family: "Inter", sans-serif;

      }

      .ticket-container {
        max-width: 600px;
        margin: 0 auto;
        font-family: "Inter", sans-serif;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-direction: column;
        background: #fbe49c;
      }

      .event-details {
        background: #ffc513;
        border-radius: 15px;
        margin: 15px 0;
        padding: 10px 10px;
        font-size: 18px;
        width: 85%;
        box-shadow: -4px 6px 12px rgba(0, 0, 0, 0.15),
          inset 0 2px 4px rgba(255, 255, 255, 0.4);
      }

      .barcode {
        text-align: center;
        margin: 20px 0;
      }

      .barcode img {
        max-width: 300px;
        height: auto;
      }

      .ticket-info {
        background: #ffc513;
        border-radius: 15px;
        margin: 15px 0;
        padding: 10px 10px;
        font-size: 18px;
        width: 85%;
        color: #000;
        line-height: 1.5;
        box-shadow: -4px 6px 12px rgba(0, 0, 0, 0.15),
          inset 0 2px 4px rgba(255, 255, 255, 0.4);
      }

      .important {
        color: #d23;
        font-weight: bold;
      }

     .ticket-header {
        display: flex;
        align-items: center;
        flex-direction: column;
        background: linear-gradient(
          to bottom,
          #ffc513,
          #ffc500ff,
          #d5ab07ff,
          #543d09ff
        );
        padding: 20px 0;
        width: 100%;
      }

      .ticket-header h1 {
        font-family: "Spongebob", serif;
        color: #000;
        font-size: 30px;
        text-align: center;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        text-shadow: -1px -1px 0 #fff, 1px -1px 0 #fff, -1px 1px 0 #fff,
          1px 1px 0 #fff;
      }

      .ticket-header .ticket-paragraph {
        font-weight: 500;
        color: black;
        margin-top: -3%;
        font-size: 20px;
        padding-bottom: 20px;
      }

      .ticket-header .ticket-header-dets {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 10px;
        background: black;
        color: #ffc513;
        padding: 2px 10px;
        font-size: 18px;
        font-weight: 700;
        border-radius: 15px;
        letter-spacing: 2px;
      }

      .ticket-circle {
        width: 8px;
        height: 8px;
        background-color: #ffc513;
        border-radius: 50%;
        display: inline-block;
      }

      .ticket-container .attendeeName {
        font-size: 25px;
        text-align: center;
        font-weight: 700;
      }

      .ticket-container .ticket-eventName {
        font-weight: 700;
      }

      .ticket-number {
        font-size: 16px;
        color: #666;
        padding: 0 6px;
      }

      .dashed {
        width: 90%;
        height: 2px;
        border-top: 5px dashed #ffc513;
        margin-top: 30px;
      }
    </style>
  </head>

  <body>
    <div class="ticket-container">
      <div class="ticket-header">
  <h1>Young People In Tech</h1>
            <p class="ticket-paragraph">{{eventName}} Access Pass 🎉</p>
            <div class="ticket-header-dets">
                <p>Tech Convos</p>
                <span class="ticket-circle"></span>
                <p>Networking</p>
                <span class="ticket-circle"></span>
                <p>Good Vibes</p>
            </div>
        </div>
      </div>
      <h1 class="attendeeName">Your Pass Is Ready!{{attendeeName}} 🎫</h1>

      {{#if isMultipleTickets}}
      <p>
        Congratulation, you're all set for
        <span class="ticket-eventName">{{eventName}}</span>
      </p>
      {{else}}
      <p>
        Congratulation, you're all set for
        <span class="ticket-eventName">{{eventName}}</span>
      </p>

      {{#if ../isMultipleTickets}}
      <span class="ticket-number"
        >Ticket {{add @index 1}} of {{../totalTickets}} 🎉</span
      >
      {{/if}} {{/if}} {{#each tickets}}
      <div class="event-details">
        <p><strong>📅 Date:</strong> {{../eventDate}}</p>
        <p><strong>🕒 Time:</strong> 1:00 pm</p>
        <p><strong>📍 Venue:</strong> {{../venue}}</p>
        <p><strong>🔢 Access ID:</strong> {{ticketId}}</p>
      </div>
      {{/each}}
      <p>Scan this code during entry</p>

      <div class="barcode">
        <img src="{{cidForbarcodeUrl}}" alt="Ticket Barcode" />
      </div>

      <div class="ticket-info">
        <p class="important">🚨 Important Heads Up!</p>
        <ul>
          <li>Arrive 30 mins early to beat the crowd</li>
          <li>
            {{#if isMultipleTickets}}Each access is{{else}}This access is{{/if}}
            a one-time magic pass 🔐
          </li>
          <li>Don't forget your ID! 👮</li>
        </ul>
      </div>

      {{#if isMultipleTickets}}
      <p>🎊 Total Tickets Purchased: {{totalTickets}} 🎊</p>
      {{/if}}

      <div class="dashed"></div>
      <p style="font-size: 18px; padding-top: 10px; text-align: center;">
        Get Ready for an Ultimate Tech Networking Party!
      </p>
      <p style="font-size: 18px; margin-top: -2%; text-align: center;">✨See you there!✨</p>

      <p style="text-align: center">
        Can't wait to see you there!<br />
        All of us at Young People In Tech
      </p>

      <p
        style="
          padding-bottom: 2px;
          font-size: 14px;
          display: flex;
          flex-direction: column;
          align-items: center;
        "
      >
        Got questions? We're all ears! 👂<span>Just give us Hola at us.</span>
      </p>
    </div>
  </body>
</html>
