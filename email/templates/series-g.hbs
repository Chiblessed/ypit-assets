<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>🎉 Your Event Access Is Ready!</title>
    <style>
      @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap');

      body {
        margin: 0;
        padding: 0;
        background-color: #fbe49c;
        font-family: "Inter", Arial, sans-serif;
        -webkit-text-size-adjust: 100%;
        -ms-text-size-adjust: 100%;
      }

      table {
        border-spacing: 0;
        border-collapse: collapse;
        mso-table-lspace: 0pt;
        mso-table-rspace: 0pt;
      }

      td {
        padding: 0;
      }

      img {
        border: 0;
        -ms-interpolation-mode: bicubic;
      }

      .wrapper {
        width: 100%;
        table-layout: fixed;
        background-color: #fbe49c;
        padding-bottom: 40px;
      }

      .main-table {
        background-color: #fbe49c;
        margin: 0 auto;
        width: 100%;
        max-width: 600px;
        font-family: "Inter", Arial, sans-serif;
      }

      .header-gradient {
        background-color: #ffc600; /* Fallback */
        background: linear-gradient(to bottom, #ffc600, #ffc500, #d5ab07, #543d09);
      }

      .event-details {
        background-color: #ffc600;
        border-radius: 15px;
        padding: 15px;
        font-size: 18px;
        box-shadow: -4px 6px 12px rgba(0, 0, 0, 0.15), inset 0 2px 4px rgba(255, 255, 255, 0.4);
      }

      .ticket-info {
        background-color: #ffc600;
        border-radius: 15px;
        padding: 15px;
        font-size: 18px;
        box-shadow: -4px 6px 12px rgba(0, 0, 0, 0.15), inset 0 2px 4px rgba(255, 255, 255, 0.4);
        color: #000000;
        line-height: 1.5;
      }

      .footer-text {
        font-size: 12px;
        color: #666666;
        text-align: center;
        line-height: 1.5;
      }

      .footer-text a {
        color: #666666;
        text-decoration: underline;
      }

      .dashed-line {
        border-top: 2px dashed #ffc600;
        width: 90%;
        height: 2px;
        margin-top: 20px;
        margin-bottom: 20px;
      }
    </style>
  </head>
  <body>
    <center class="wrapper">
      <table class="main-table" role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" align="center">
        <!-- Header Image -->
        <tr>
          <td align="center" style="padding-bottom: 0;">
            <img src="{{headerImageUrl}}" alt="Young People In Tech - Event Access Pass" width="600" style="max-width: 100%; height: auto; display: block;" />
          </td>
        </tr>

        <!-- Attendee Name -->
        <tr>
          <td align="center" style="padding: 20px 0;">
            <h1 style="font-size: 25px; font-weight: 700; margin: 0; font-family: 'Inter', Arial, sans-serif;">Your Pass Is Ready! {{attendeeName}} 🎫</h1>
          </td>
        </tr>

        <!-- Intro Text -->
        <tr>
          <td align="center" style="padding: 0 20px;">
            <p style="font-size: 16px; margin: 10px 0; font-family: 'Inter', Arial, sans-serif;">
              Congratulations, you're all set for <strong>{{eventName}}</strong>
            </p>
          </td>
        </tr>

        <!-- Tickets Loop -->
        <tr>
          <td align="center" style="padding: 0 20px;">
            {{#each tickets}}
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0" style="margin-bottom: 40px;">
              <tr border="0">
                <td class="event-details">
                  {{#if ../isMultipleTickets}}
                  <p style="margin: 5px 0; font-weight: bold; color: #444; font-family: 'Inter', Arial, sans-serif;">Ticket {{add @index 1}} of {{../totalTickets}}</p>
                  {{/if}}
                  <p style="margin: 5px 0; font-family: 'Inter', Arial, sans-serif;"><strong>📅 Date:</strong> {{../eventDate}}</p>
                  <p style="margin: 5px 0; font-family: 'Inter', Arial, sans-serif;"><strong>🕒 Time:</strong> {{../eventTime}}</p>
                  <p style="margin: 5px 0; font-family: 'Inter', Arial, sans-serif;"><strong>📍 Venue:</strong> {{../venue}}</p>
                  <p style="margin: 5px 0; font-family: 'Inter', Arial, sans-serif;"><strong>🔢 Access ID:</strong> {{ticketId}}</p>
                </td>
              </tr>
              <!-- Barcode per ticket -->
              <tr>
                <td align="center" style="padding: 10px 0;">
                  <p style="margin-bottom: 10px; font-family: 'Inter', Arial, sans-serif;">Scan this code during entry</p>
                  <img src="{{barcodeCid}}" alt="Ticket Barcode" width="300" style="max-width: 300px; height: auto; display: block;" />
                </td>
              </tr>
            </table>
            {{/each}}
          </td>
        </tr>

        <!-- Important Info -->
        <tr>
          <td align="center" style="padding: 20px;">
            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" border="0">
              <tr>
                <td class="ticket-info" style="text-align: left;">
                  <p style="color: #d23; font-weight: bold; margin-top: 0; font-family: 'Inter', Arial, sans-serif;">🚨 Important Heads Up!</p>
                  <ul style="margin-bottom: 0; font-family: 'Inter', Arial, sans-serif;">
                    <li>Arrive 30 mins early to beat the crowd</li>
                    <li>{{#if isMultipleTickets}}Each access is{{else}}This access is{{/if}} a one-time magic pass 🔐</li>
                    <li>Don't forget your ID! 👮</li>
                  </ul>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        {{#if isMultipleTickets}}
        <tr>
          <td align="center">
            <p style="font-family: 'Inter', Arial, sans-serif;">🎊 Total Tickets Purchased: {{totalTickets}} 🎊</p>
          </td>
        </tr>
        {{/if}}

        <!-- Dashed Line -->
        <tr>
          <td align="center">
            <div class="dashed-line"></div>
          </td>
        </tr>

        <!-- Closing -->
        <tr>
          <td align="center" style="padding: 10px 20px;">
            <p style="font-size: 18px; margin: 10px 0; font-family: 'Inter', Arial, sans-serif;">Get Ready for an Ultimate Tech Networking Party!</p>
            <p style="font-size: 18px; margin: 5px 0; font-family: 'Inter', Arial, sans-serif;">✨See you there!✨</p>
          </td>
        </tr>

        <!-- Dashed Line -->
        <tr>
          <td align="center">
            <div class="dashed-line"></div>
          </td>
        </tr>

        <!-- Compliance Footer -->
        <tr>
          <td align="center" style="padding: 20px;">
            <p class="footer-text" style="font-family: 'Inter', Arial, sans-serif;">
              &copy; 2025 Young People In Tech. All rights reserved.<br>
              38, Okota Road, Isolo Lagos<br>
            </p>
          </td>
        </tr>

      </table>
    </center>
  </body>
</html>
